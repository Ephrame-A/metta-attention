!(bind! &node (new-space))
!(import! &node ../../../ImportanceDiffusionAgent/AFImportanceDiffusionAgent/tests/nodes)

!(updateAttentionParam MAX_AF_SIZE 100)
!(match &node ($x) (setSti $x 100))

(= (run-cycles $num $time)
    (if (== $num 0) (running time is (- (py-call (time.time)) $time))
        (let* (
            ($x (collapse (WARentCollectionAgent-Run))) 
            )
        (run-cycles (- $num 1) $time))
    )
)

!(getAv node_500)
!(run-cycles 50 (py-call (time.time)))
; !(WARentCollectionAgent-Run)
!(getAv node_500)
!(with 50 cycles and 100af)